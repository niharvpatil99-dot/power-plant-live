# Server Port & Binding (Provided automatically by Render)
PORT=5000
HOST=0.0.0.0

# Security Secret Key (Generate a random 32-character string for production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production

# WebSocket Engine Mode: 'eventlet' (Render/Linux) or 'threading' (Windows Localhost)
SOCKETIO_ASYNC_MODE=eventlet

# Database Path (Optional: defaults to database/power_plant.db)
# DATABASE_PATH=/var/data/power_plant.db
